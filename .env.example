# Copie ce fichier vers .env et renseigne les valeurs. Ne commit jamais .env.

# https://create.roblox.com/dashboard/credentials
# Scopes requis: universe-places:read, universe-places:write, assets:write
ROBLOX_API_KEY=

# Depuis le Creator Dashboard de l'expérience (Configure -> ID de l'univers/de la place)
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=

# https://console.anthropic.com/settings/keys — utilisé pour générer le
# design du jeu et le code Luau (meilleure qualité).
ANTHROPIC_API_KEY=

# Repli 100% gratuit (pas de carte bancaire) si tu n'as pas encore de crédit
# Anthropic : https://console.groq.com/keys — utilisé automatiquement si
# ANTHROPIC_API_KEY est vide ou en échec.
GROQ_API_KEY=
